// GitHub Codespaces / VS Code Dev Containers: a Linux workspace with Docker, Node.js and
// uv, so the whole stack runs with the compose command from the README. See docs/codespaces.md.
{
  "name": "Eagle Eye",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // Its own Docker engine inside the codespace (no Docker Desktop or WSL on your PC).
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "26" },
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  // uv installs the Python version in backend/.python-version on first use.
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  // The stack needs about 6 GB of memory; this picks at least the 2-core, 8 GB machine.
  "hostRequirements": { "memory": "8gb", "storage": "32gb" },
  // Opened in VS Code desktop, these appear on your own machine as localhost:<port>, which
  // the sign-in redirects (Keycloak at localhost:8180) and browser uploads rely on.
  "forwardPorts": [8080, 8000, 8180, 10000, 8025],
  "portsAttributes": {
    "8080": { "label": "Web app", "onAutoForward": "notify", "requireLocalPort": true },
    "8000": { "label": "API", "onAutoForward": "silent", "requireLocalPort": true },
    "8180": { "label": "Keycloak (sign-in)", "onAutoForward": "silent", "requireLocalPort": true },
    "10000": { "label": "Azurite (evidence uploads)", "onAutoForward": "silent", "requireLocalPort": true },
    "8025": { "label": "Mailpit", "onAutoForward": "silent", "requireLocalPort": true }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "charliermarsh.ruff",
        "hashicorp.terraform"
      ]
    }
  }
}
